# ============================================================
# Secrets / Credentials
# ============================================================

# Environment files
.env
.env.*
!.env.example

# Generic credential files
credentials
credentials.*
*credentials*
*credential*

# Password files
*password*
*passwd*

# Secret directories
secrets/
**/secrets/

# Secret files
secret.yml
secret.yaml
secrets.yml
secrets.yaml

# SSH private keys
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*

# Generic private keys / certificates containing private material
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore

# ============================================================
# Python Runtime / Generated Files
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# Frontend / Node.js Generated Files
# ============================================================

node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ============================================================
# Logs / Dumps / Generated Data
# ============================================================

*.log
*.dump
*.sql
!backend/migrations/audit/*.sql
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip

# ============================================================
# Temporary / Editor Files
# ============================================================

*.tmp
*.temp
*.swp
*.swo
*~

.vscode/
.idea/

# Local tool caches
.uv-cache/
.npm-cache/
.browser-cache/
test-results/
playwright-report/

# ============================================================
# OS Metadata
# ============================================================

.DS_Store
Thumbs.db

# Preserved protection rules from the initial hybrid-app main
# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout
