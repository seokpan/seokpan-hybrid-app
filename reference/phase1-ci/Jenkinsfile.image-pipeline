                                writeFile file: 'image-metadata.json', text: metadataJson
                                archiveArtifacts artifacts: 'image-metadata.json', fingerprint: true
                                echo "Evidence 기록 완료: image-metadata.json"
                            }
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // GitOps Promotion (#98):
        // 검증된 Final image가 모두 확정된 뒤, Harbor credential이 마운트되지
        // 않는 app-ci-check Agent에서 GitHub promotion credential만 명시적으로
        // 바인딩해 GitOps branch/commit/push/PR 생성까지 수행한다.
        // main 직접 push / auto-merge / Cluster 직접 변경은 하지 않는다.
        // --------------------------------------------------------------
        stage('Create GitOps Promotion PR') {
            when {
                beforeAgent true
                allOf {
                    expression { env.P1_PASSED == 'true' }
                    expression { currentBuild.currentResult == 'SUCCESS' }
                    expression {
                        env.FINAL_DIGEST_BACKEND &&
                        env.FINAL_DIGEST_FRONTEND
                    }
                }
            }
            agent { kubernetes { inheritFrom 'app-ci-check' } }
            steps {
                container('app-ci') {
                    script {
                        // Branch Guard에서 고정한 App main Commit을 새 Agent에서도
                        // 정확히 다시 Checkout한다. 최신 main을 임의로 따라가지 않는다.
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: env.SEOKPAN_GIT_SHA]],
                            userRemoteConfigs: [[url: scm.userRemoteConfigs[0].url]]
                        ])

                        def actualSha = sh(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                        ).trim()

                        if (actualSha != env.SEOKPAN_GIT_SHA) {
                            error(
                                "Promotion source mismatch: expected " +
                                "${env.SEOKPAN_GIT_SHA}, got ${actualSha}"
                            )
                        }
                    }

                    sh '''
                        set -eu
                        python3 --version
                        git --version
                        python3 scripts/test_promote_gitops.py
                    '''

                    withCredentials([usernamePassword(
                        credentialsId: 'gitops-promotion-github',
                        usernameVariable: 'GITOPS_GITHUB_USER',
                        passwordVariable: 'GITOPS_GITHUB_TOKEN'
                    )]) {
                        sh '''
                            set -eu
                            python3 scripts/promote_gitops.py \
                              --result-file gitops-promotion-result.json
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gitops-promotion-result.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }
    }

    post {
        failure {
            echo "Image Pipeline 실패: ${env.CANDIDATE_TAG ?: 'N/A'} / ${env.FINAL_TAG ?: 'N/A'} (scan-* Candidate는 삭제하지 않고 보존, Retention 정책으로 추후 정리 예정)"
        }
        success {
            echo "Image Pipeline 성공: ${env.FINAL_TAG} Final 상태 정상. Candidate 정리 결과: ${env.CLEANUP_SUMMARY ?: '기록 없음'}. Scan 요약: ${env.SCAN_SUMMARY ?: '기록 없음'}"
        }
    }
}
