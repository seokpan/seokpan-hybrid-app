// ============================================================================
// seokpan-app :: main Image Pipeline
//
// Issue #58 P2:
//   main Commit
//     -> P1 Revalidation
//     -> Backend/Frontend Candidate Build + native SBOM/Provenance
//     -> Candidate Push-time Digest
//     -> Trivy Scan
//     -> Candidate Health Process Smoke
//     -> Final git-* Promote
//     -> Final Digest Verify
//     -> Candidate scan-* Tag-only Cleanup
//     -> image-metadata.json Evidence
//
// Fail-closed:
//   - PR context / non-main 실행 금지
//   - P1 실패 시 Image 작업 금지
//   - CRITICAL 또는 fixable HIGH 발견 시 Promote 금지
//   - Candidate Health Smoke 실패 시 Promote 금지
//   - Harbor API / Guard / Digest 오류 시 중단
//
// GitOps Promotion (#98):
//   검증된 Final Digest 확정 뒤 별도 app-ci-check Agent에서
//   component provenance/impact를 판정하고 seokpan-gitops PR 생성까지 자동화한다.
//   GitOps main 직접 push/auto-merge/Cluster 직접 변경은 하지 않는다.
//
// Health Smoke:
//   target 컨테이너 내부 Jenkins Durable Task(sh)는 실제 Tmp Job에서
//   실패가 재현되어 사용하지 않는다.
//   원래 CMD로 기동된 target을 같은 Pod의 checker가
//   /health/live HTTP 200으로 검증한다.
//
// Retention:
//   현재 Harbor seokpan Project Retention은 미구성.
//   별도 seokpan-infra 후속 범위에서 결정한다.
// ============================================================================

def COMPONENT_REPO = [
    backend : 'backend',
    frontend: 'frontend'
]

// Health Smoke 대상 설정값 (docs/ci-verification.md 기준 고정값)
def HEALTH_CFG = [
    backend : [port: 8000, uid: 10001, path: '/health/live'],
    frontend: [port: 8080, uid: 101,   path: '/health/live']
]

pipeline {
    agent none

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        disableRestartFromStage()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        HARBOR_HOST     = 'harbor.seokpan.soldesk.store'
        HARBOR_PROJECT  = 'seokpan'
        HARBOR_API_CRED = 'harbor-api-robot-account'
        HARBOR_CA_PATH  = '/etc/buildkit/certs/ca.crt'
    }

    stages {

        // --------------------------------------------------------------
        // Branch Guard + 변수 준비. 가벼운 작업이라 buildkit-rootless를
        // 재사용(별도 lightweight agent 추가하지 않음).
        // --------------------------------------------------------------
        stage('Branch Guard & Prepare') {
            agent { kubernetes { inheritFrom 'buildkit-rootless' } }
            steps {
                script {
                    if (env.CHANGE_ID) {
                        error("이 Pipeline은 PR 컨텍스트(CHANGE_ID=${env.CHANGE_ID})에서 실행되면 안 됩니다.")
                    }
                    if (env.BRANCH_NAME != 'main') {
                        error("이 Pipeline은 main 브랜치 전용입니다 (현재 BRANCH_NAME=${env.BRANCH_NAME}).")
                    }
                    echo "Branch Guard 통과: BRANCH_NAME=main, PR 컨텍스트 아님"

                    // [수정, App Jenkinsfile v3.1 대조 반영] sh('git rev-parse HEAD') 대신
                    // checkout scm의 반환값을 사용. 환경변수 이름도 App 쪽 검사 스크립트가
                    // 실제로 참조하는 계약(SEOKPAN_GIT_SHA / SEOKPAN_CI_RUN_ID)과 정확히
                    // 맞춤 — 임의로 다른 이름(RUN_ID 등)을 쓰면 verify_ci.py/verify:ci 등이
                    // 내부적으로 기대하는 값과 어긋날 위험이 있음.
                    def scmVars = checkout scm
                    env.SEOKPAN_GIT_SHA   = scmVars.GIT_COMMIT
                    // App 쪽과 동일한 "a09-<build>-<sha12>" 컨벤션 그대로 사용. 이 Job은
                    // App CI Check Job과 완전히 별도 Workspace(별도 Job)라 test-results/
                    // 경로 충돌 위험 자체가 없으므로, 접두사를 굳이 분리할 이유가 없음.
                    env.SEOKPAN_CI_RUN_ID = "a09-${env.BUILD_NUMBER}-${env.SEOKPAN_GIT_SHA.take(12)}"
                    env.MAIN_SHA_12    = env.SEOKPAN_GIT_SHA.take(12)
                    env.CANDIDATE_TAG  = "scan-${env.MAIN_SHA_12}-${env.BUILD_NUMBER}"
                    env.FINAL_TAG      = "git-${env.MAIN_SHA_12}"
                    echo "Commit: ${env.SEOKPAN_GIT_SHA}"
                    echo "RUN_ID: ${env.SEOKPAN_CI_RUN_ID}"
                    echo "Candidate tag: ${env.CANDIDATE_TAG} / Final tag: ${env.FINAL_TAG}"
                }
            }
        }

        // --------------------------------------------------------------
        // P1 Revalidation: docs/ci-verification.md 기준 App CI Check
        // 6단계 전체를 main pinned commit에 재적용. app-ci-check/app-ci
        // Agent 재사용 (buildkit-rootless에 도구 재설치 안 함).
        // 실패 시 이후 Image 작업으로 절대 진행되지 않음(Declarative
        // Pipeline은 상위 stage 실패 시 하위 stage를 자동 skip).
        // --------------------------------------------------------------
        stage('P1 Revalidation (App CI Check on main)') {
            agent { kubernetes { inheritFrom 'app-ci-check' } }
            environment {
                // [반영] App Jenkinsfile v3.1과 동일. verify_ci.py 등이 HOME 기준으로
                // 캐시/설정 경로를 잡을 수 있어 명시적으로 맞춤.
                HOME = '/tmp'
            }
            stages {
                stage('Checkout') {
                    steps {
                        container('app-ci') {
                            script {
                                // main의 최신 상태를 다시 받는 게 아니라, Branch Guard &
                                // Prepare에서 고정한 정확히 같은 Commit을 재확인 Checkout.
                                def scmVars = checkout scm
                                if (scmVars.GIT_COMMIT != env.SEOKPAN_GIT_SHA) {
                                    error("Commit mismatch on app-ci-check agent: expected ${env.SEOKPAN_GIT_SHA}, got ${scmVars.GIT_COMMIT}")
                                }
                                sh 'id'
                                echo "commit=${env.SEOKPAN_GIT_SHA} run_id=${env.SEOKPAN_CI_RUN_ID}"
                            }
                        }
                    }
                }

                // [수정] App Jenkinsfile v3.1 원본 그대로 반영 — 제 이전 재구성은
                // 동작이 반대였음(기존 캐시 있으면 스킵 vs 원본은 에러로 중단,
                // write-test 성공 시 무시 vs 원본은 명시적 실패).
                stage('Prepare Browser Cache') {
                    steps {
                        container('app-ci') {
                            dir('frontend') {
                                sh '''
                                    set -eu
                                    SRC="/opt/playwright-cache"
                                    DEST=".browser-cache"

                                    # 새 작업 공간에 예상외 캐시가 있으면 덮어쓰거나 삭제하지 않고 중단
                                    if [ -e "$DEST" ] || [ -L "$DEST" ]; then
                                        echo "ERROR: $DEST already exists in a fresh workspace. Aborting." >&2
                                        exit 1
                                    fi

                                    START=$(date +%s)
                                    SRC_SIZE=$(du -sh "$SRC" | cut -f1)
                                    cp -r "$SRC" "$DEST"
                                    END=$(date +%s)
                                    echo "browser-cache copy: ${SRC_SIZE}, $((END-START))s, src=${SRC}"

                                    REVISION_DIR="$DEST/chromium_headless_shell-1243"
                                    [ -d "$REVISION_DIR" ] || { echo "ERROR: revision 1243 missing" >&2; exit 1; }
                                    BIN=$(find "$REVISION_DIR" -type f -name "headless_shell" -o -name "chrome-headless-shell" | head -1)

                                    [ -n "$BIN" ] && [ -x "$BIN" ] || { echo "ERROR: binary missing/not executable" >&2; exit 1; }
                                    if ldd "$BIN" 2>&1 | grep -q "not found"; then
                                        echo "ERROR: missing shared libraries:" >&2
                                        ldd "$BIN" | grep "not found" >&2
                                        exit 1
                                    fi

                                    if touch "$SRC/.write-test" 2>/dev/null; then
                                        echo "ERROR: source is writable by CI UID - security regression" >&2
                                        exit 1
                                    fi
                                    echo "source read-only confirmed"
                                '''
                            }
                        }
                    }
                }

                stage('Backend: Install & Verify') {
                    steps {
                        container('app-ci') {
                            dir('backend') {
                                sh 'python scripts/verify_ci.py --run-id ${SEOKPAN_CI_RUN_ID} --uv /usr/local/bin/uv'
                            }
                        }
                    }
                }

                stage('OpenAPI Export') {
                    steps {
                        container('app-ci') {
                            dir('backend') {
                                sh '.venv/bin/python scripts/export_openapi_ci.py --run-id ${SEOKPAN_CI_RUN_ID}'
                            }
                        }
                    }
                }

                stage('Frontend: Install & Verify') {
                    steps {
                        container('app-ci') {
                            dir('frontend') {
                                // verify:ci가 Format/Lint/TypeCheck/도구시험/기능시험/Build/Audit까지
                                // 전부 포함 (npm audit 별도 스텝 불필요, ci-verification.md 확인됨)
                                sh 'npm run verify:ci -- --run-id ${SEOKPAN_CI_RUN_ID}'
                            }
                        }
                    }
                }

                stage('Browser: UI') {
                    steps {
                        container('app-ci') {
                            dir('frontend') {
                                sh 'npm run e2e:ci -- ui --run-id ${SEOKPAN_CI_RUN_ID}'
                            }
                        }
                    }
                }

                stage('Browser: Full') {
                    steps {
                        container('app-ci') {
                            dir('frontend') {
                                sh 'npm run e2e:ci -- full --run-id ${SEOKPAN_CI_RUN_ID}'
                            }
                        }
                    }
                }

                stage('Aggregate') {
                    steps {
                        container('app-ci') {
                            dir('backend') {
                                script {
                                    // 집계 "시도" 여부를 호출 전에 기록 - post에서 재집계하지 않음
                                    env.P1_AGGREGATE_ATTEMPTED = 'true'
                                    sh 'python scripts/summarize_ci.py --run-id ${SEOKPAN_CI_RUN_ID}'
                                }
                            }
                            // 정상 경로는 엄격하게: 비어있으면 그 자체로 실패 (allowEmptyArchive 없음)
                            archiveArtifacts(
                                artifacts: "test-results/${env.SEOKPAN_CI_RUN_ID}/**",
                                fingerprint: true
                            )
                            script { env.P1_PASSED = 'true' }
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        try {
                            container('app-ci') {
                                if (env.P1_AGGREGATE_ATTEMPTED != 'true') {
                                    dir('backend') {
                                        sh 'python scripts/summarize_ci.py --run-id ${SEOKPAN_CI_RUN_ID} || true'
                                    }
                                }
                                archiveArtifacts(
                                    artifacts: "test-results/${env.SEOKPAN_CI_RUN_ID}/**",
                                    allowEmptyArchive: true,
                                    fingerprint: true
                                )
                            }
                        } catch (Exception e) {
                            echo "WARN: fallback collection skipped (agent/container unavailable): ${e.getMessage()}"
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // Harbor 작업 그룹: buildkit-rootless 하나의 Pod을 공유하며
        // Guard -> Candidate Build(+SBOM/Provenance, digest) -> Scan -> Candidate Health ->
        // Promote -> Verify&Cleanup -> Health Smoke -> Evidence 순서로
        // 진행. P1이 실패하면 이 그룹 전체가 자동으로 skip됨.
        // --------------------------------------------------------------
        stage('Image Build & Harbor Operations') {
            // [추가] App Jenkinsfile의 "보완사항 ④"와 동일한 이유로 명시적 가드 추가.
            // Declarative의 자동 stage-skip만으로는 불충분하다는 게 이미 팀 리뷰로
            // 확정된 방향이라 동일하게 적용 — 오히려 이 그룹은 Harbor에 실제 쓰기
            // 작업을 하므로 PR Build Verify보다 더 엄격하게 가드해야 함.
            when {
                beforeAgent true
                allOf {
                    expression { env.P1_PASSED == 'true' }
                    expression { currentBuild.currentResult == 'SUCCESS' }
                }
            }
            agent { kubernetes { inheritFrom 'buildkit-rootless' } }
            stages {

                // [수정] App Jenkinsfile v3.1의 Build Verify (PR) 그룹과 동일한 패턴으로
                // 교체. 단순 checkout scm은 "이 브랜치의 최신"을 다시 받아올 위험이
                // 있으므로, Branch Guard & Prepare에서 고정한 정확한 Commit을 GitSCM으로
                // 명시 지정하고 실제 체크아웃된 SHA가 일치하는지 검증한다. buildkit
                // 컨테이너에는 git이 없을 수 있어 container() 블록 없이(자동 주입되는
                // jnlp 컨테이너에서) 실행한다.
                stage('Checkout (pinned main SHA)') {
                    steps {
                        script {
                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: env.SEOKPAN_GIT_SHA]],
                                userRemoteConfigs: [[url: scm.userRemoteConfigs[0].url]]
                            ])
                            def actualSha = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                            if (actualSha != env.SEOKPAN_GIT_SHA) {
                                error "Commit mismatch: expected ${env.SEOKPAN_GIT_SHA}, got ${actualSha}"
                            }
                        }
                    }
                }

                stage('Guard: Final Tag Check') {
                    steps {
                        container('python') {
                            withCredentials([usernamePassword(
                                credentialsId: env.HARBOR_API_CRED,
                                usernameVariable: 'HARBOR_API_USER',
                                passwordVariable: 'HARBOR_API_PASS'
                            )]) {
                                script {
                                    COMPONENT_REPO.each { component, repo ->
                                        env.CURRENT_REPO = repo
                                        def status = sh(
                                            script: '''
                                                python3 - <<'PYEOF'
import os, sys, json, ssl, urllib.request, urllib.error, base64

host  = os.environ["HARBOR_HOST"]
proj  = os.environ["HARBOR_PROJECT"]
repo  = os.environ["CURRENT_REPO"]
tag   = os.environ["FINAL_TAG"]
sha12 = os.environ["MAIN_SHA_12"]
user  = os.environ["HARBOR_API_USER"]
pw    = os.environ["HARBOR_API_PASS"]

ctx = ssl.create_default_context(cafile=os.environ["HARBOR_CA_PATH"])
url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{tag}"
req = urllib.request.Request(url)
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
req.add_header("Authorization", f"Basic {auth}")

try:
    with urllib.request.urlopen(req, timeout=15, context=ctx) as resp:
        data = json.loads(resp.read())
        digest = data.get("digest")
        if resp.status != 200 or not digest:
            print("ERR", file=sys.stderr)
            sys.exit(1)

        tags = [
            t.get("name")
            for t in (data.get("tags") or [])
            if isinstance(t, dict) and t.get("name")
        ]

        stale = sorted(
            name for name in tags
            if name.startswith(f"scan-{sha12}-")
        )

        stale_field = ",".join(stale) if stale else "-"
        print(f"200 {digest} {stale_field}")
except urllib.error.HTTPError as e:
    print(e.code)
except Exception as e:
    print("ERR", file=sys.stderr)
    print(str(e), file=sys.stderr)
    print("-1")
PYEOF
                                            ''',
                                            returnStdout: true
                                        ).trim()

                                        echo "Guard [${component}/${repo}] result: ${status}"

                                        def existing = (
                                            status =~ /^200 (sha256:[0-9a-f]+) (.+)$/
                                        )

                                        if (existing) {
                                            def digest = existing[0][1]
                                            def staleField = existing[0][2]
                                            def staleCandidates =
                                                (staleField == '-') ?
                                                '' :
                                                staleField

                                            echo(
                                                "Guard [${component}]: 기존 Final " +
                                                "${env.FINAL_TAG} 확인. " +
                                                "재실행 복구 대상으로 재사용한다. " +
                                                "digest=${digest}"
                                            )

                                            if (component == 'backend') {
                                                env.FINAL_EXISTS_BACKEND = 'true'
                                                env.FINAL_DIGEST_BACKEND = digest
                                                env.STALE_CANDIDATES_BACKEND =
                                                    staleCandidates
                                            } else {
                                                env.FINAL_EXISTS_FRONTEND = 'true'
                                                env.FINAL_DIGEST_FRONTEND = digest
                                                env.STALE_CANDIDATES_FRONTEND =
                                                    staleCandidates
                                            }

                                        } else if (status == '404') {
                                            echo "Guard [${component}]: Final 없음, 현재 Run에서 처리."

                                            if (component == 'backend') {
                                                env.FINAL_EXISTS_BACKEND = 'false'
                                            } else {
                                                env.FINAL_EXISTS_FRONTEND = 'false'
                                            }

                                        } else {
                                            error(
                                                "Guard: [${component}] 예상치 못한 응답" +
                                                "(${status}), fail-closed 중단."
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                stage('Build & Push Candidate (+push-time digest 캡처)') {
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: env.HARBOR_API_CRED,
                            usernameVariable: 'HARBOR_API_USER',
                            passwordVariable: 'HARBOR_API_PASS'
                        )]) {
                            script {
                                COMPONENT_REPO.each { component, repo ->
                                    def finalExists =
                                        (component == 'backend') ?
                                        env.FINAL_EXISTS_BACKEND :
                                        env.FINAL_EXISTS_FRONTEND

                                    if (finalExists == 'true') {
                                        echo(
                                            "[${component}] 기존 immutable Final 재사용 - " +
                                            "Candidate Build/Push 생략"
                                        )
                                    } else {
                                        container('buildkit') {
                                        sh """
                                            buildctl-daemonless.sh build \\
                                              --frontend dockerfile.v0 \\
                                              --local context=./${component} \\
                                              --local dockerfile=./${component} \\
                                              --opt attest:sbom=generator=docker.io/docker/buildkit-syft-scanner@sha256:ae4f3b554449e7e25548e7d8ccc029d17357348e30c6e3df01b92bc93654d6a9 \\
                                              --opt attest:provenance=mode=min \\
                                              --output type=image,name=${env.HARBOR_HOST}/${env.HARBOR_PROJECT}/${repo}:${env.CANDIDATE_TAG},push=true
                                        """
                                    }
                                    container('python') {
                                        env.CURRENT_REPO = repo
                                        def digest = sh(
                                            script: '''
                                                python3 - <<'PYEOF'
import os, sys, json, ssl, urllib.request, urllib.error, base64

host = os.environ["HARBOR_HOST"]; proj = os.environ["HARBOR_PROJECT"]
repo = os.environ["CURRENT_REPO"]; cand = os.environ["CANDIDATE_TAG"]
user = os.environ["HARBOR_API_USER"]; pw = os.environ["HARBOR_API_PASS"]

ctx = ssl.create_default_context(cafile=os.environ["HARBOR_CA_PATH"])
url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{cand}"
req = urllib.request.Request(url)
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
req.add_header("Authorization", f"Basic {auth}")

try:
    with urllib.request.urlopen(req, timeout=15, context=ctx) as resp:
        print(json.loads(resp.read())["digest"])
except Exception as e:
    print(f"[{repo}] Push 직후 Digest 캡처 실패: {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
                                            ''',
                                            returnStdout: true
                                        ).trim()
                                        // [수정, Sandbox 차단 대응] env["동적키"] = 값 형태는
                                        // Jenkins Groovy Sandbox가 DefaultGroovyMethods.putAt을
                                        // 승인 목록에서 막아 RejectedAccessException을 던짐
                                        // (Tmp Job 실행에서 실제 확인됨). env는 일반 Map이 아니라
                                        // 동적 대괄호 대입 자체가 안전 목록에 없음 — 컴포넌트가
                                        // backend/frontend 둘뿐이므로 고정 이름 두 개로 대체.
                                        if (component == 'backend') {
                                            env.CAND_DIGEST_BACKEND = digest
                                        } else if (component == 'frontend') {
                                            env.CAND_DIGEST_FRONTEND = digest
                                        }
                                        echo "[${repo}] push-time digest: ${digest}"
                                    }
                                    }
                                }
                            }
                        }
                    }
                }

                stage('Scan') {
                    steps {
                        container('python') {
                            withCredentials([usernamePassword(
                                credentialsId: 'harbor-robot-account',
                                usernameVariable: 'HARBOR_ROBOT_USER',
                                passwordVariable: 'HARBOR_ROBOT_PASS'
                            )]) {
                                script {
                                    def scanSummary = [:]
                                    COMPONENT_REPO.each { component, repo ->
                                        def finalExists =
                                            (component == 'backend') ?
                                            env.FINAL_EXISTS_BACKEND :
                                            env.FINAL_EXISTS_FRONTEND

                                        if (finalExists == 'true') {
                                            echo(
                                                "[${component}] 기존 immutable Final 재사용 - " +
                                                "Scan 생략"
                                            )

                                            if (component == 'backend') {
                                                env.SCAN_BACKEND = 'SKIPPED_EXISTING_FINAL'
                                            } else {
                                                env.SCAN_FRONTEND = 'SKIPPED_EXISTING_FINAL'
                                            }
                                        } else {
                                            env.CURRENT_REPO = repo
                                        def output = sh(
                                            script: '''
                                                set -eu
                                                export SSL_CERT_FILE="${HARBOR_CA_PATH}"
                                                IMAGE_REF="${HARBOR_HOST}/${HARBOR_PROJECT}/${CURRENT_REPO}:${CANDIDATE_TAG}"
                                                REPORT_FILE="/tmp/trivy-${CURRENT_REPO}.json"

                                                trivy image \\
                                                  --scanners vuln \\
